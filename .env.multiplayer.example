# Copy to .env.multiplayer on ONE persistent server; replace the example host.
# This starts signaling only: no database, dedicated match, frontend, or TURN service.
COT_MULTIPLAYER_ADDRESS=multiplayer.example.com
COT_MULTIPLAYER_ALLOWED_ORIGINS=https://cot.kevinliu.studio

# Production uses public TCP 80/443 for HTTPS. Local smoke tests must instead
# bind 127.0.0.1, use address :80, and override ports (e.g. 18080 / 18443).
# COT_MULTIPLAYER_BIND=127.0.0.1
# COT_MULTIPLAYER_HTTP_PORT=18080
# COT_MULTIPLAYER_HTTPS_PORT=18443

# Separately set these PUBLIC build values on the Vercel frontend and rebuild:
# VITE_SIGNAL_URL=wss://multiplayer.example.com/api/signal
# No match-service URL is required for private rooms or LAN.
# Leave VITE_ICE_CONFIG_URL unset: existing Vercel /api/ice serves TURN leases.
# Do not copy backend passwords/provider secrets into VITE_* variables.
