# Local-only complete vehicle archive. Vite exposes VITE_* values to the
# browser, so this is a development switch rather than an authentication key.
# Production builds ignore it even when present.
VITE_COT_DEV_FLEET_KEY=claude-of-tanks-local-dev

# Production-only private-room relay. Configure these in the deployment, not
# in a browser-visible VITE_* variable. The recommended self-hosted route uses
# coturn's TURN REST shared secret; see docs/DEVELOPMENT.md.
# COT_TURN_URLS=turn:turn.example.test:3478,turns:turn.example.test:5349
# COT_TURN_SHARED_SECRET=
# COT_TURN_USERNAME=cot
# COT_TURN_TTL_SECONDS=28800
# Optional managed-provider or static alternatives:
# COT_CLOUDFLARE_TURN_KEY_ID=
# COT_CLOUDFLARE_TURN_API_TOKEN=
# COT_TURN_ICE_SERVERS_JSON=

# Complete first-party Docker deployment (compose.selfhost.yaml). Copy this
# file to .env, replace both required values, and point the TURN hostname at
# the same public IP. localhost defaults are suitable for a one-machine smoke
# test but cannot relay peers across the internet.
# COT_SITE_ADDRESS=:80
# COT_HTTP_PORT=8080
# COT_HTTPS_PORT=8443
# COT_PUBLIC_ORIGIN=http://localhost:8080
# COT_TURN_EXTERNAL_IP=
# COT_TURN_REALM=claude-of-tanks
