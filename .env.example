# Local-only complete vehicle archive. Vite exposes VITE_* values to the
# browser, so this is a development switch rather than an authentication key.
# Production builds ignore it even when present.
VITE_COT_DEV_FLEET_KEY=claude-of-tanks-local-dev

# Production-only private-room relay. Configure these in the deployment, not
# in a browser-visible VITE_* variable. Production keeps Cloudflare TURN;
# coturn is an optional self-hosted alternative. See docs/MULTIPLAYER-V2.md.
# COT_TURN_URLS=turn:turn.example.test:3478,turns:turn.example.test:5349
# COT_TURN_SHARED_SECRET=
# COT_TURN_USERNAME=cot
# COT_TURN_TTL_SECONDS=28800
# Optional managed-provider or static alternatives:
# COT_CLOUDFLARE_TURN_KEY_ID=
# COT_CLOUDFLARE_TURN_API_TOKEN=
# COT_TURN_ICE_SERVERS_JSON=

# Jev commander (docs/JEV-COMMANDER.md). The TypeSafe key is server-only: the
# hosted function reads it from the deployment environment and `npm run jev:dev`
# from its own shell; it never belongs in this file or in a VITE_ variable.
# TYPESAFE_API_KEY=
# Keep VITE_JEV_URL unset to retain same-origin /api/jev (the dev server forwards it to 127.0.0.1:8794).

# Optional build-time switches (browser-visible VITE_* values; leave unset to
# keep the defaults). Set them in the build environment; vite.config.ts reads
# VITE_SELF_HOSTED and VITE_TELEMETRY_URL from the shell when it writes the HTML.
# VITE_ROOMS_URL=        # rooms Worker wss:// origin; unset = the official Worker on the official host, the LAN helper on local hosts
# VITE_ICE_CONFIG_URL=   # ICE (STUN/TURN) config endpoint; unset = same-origin /api/ice on HTTPS pages
# VITE_TELEMETRY_URL=    # telemetry sink origin (cloudflare/telemetry); unset = the official sink or /api/telemetry
# VITE_TELEMETRY_SAMPLE= # share in (0, 1] of clean sessions that send the beacon (failures always send); unset = all
# VITE_SELF_HOSTED=      # 1 = self-hosted build: no Vercel Analytics and no telemetry beacon
# VITE_JEV_URL=          # Jev proxy route override (see the Jev note above)

# Server-side names (deployment or shell environment, never VITE_*):
# COT_ALLOWED_ORIGINS=   # extra comma-separated origins allowed by /api/ice, /api/jev and /api/telemetry
# COT_JEV_DEV_URL=       # where the dev server forwards /api/jev (default 127.0.0.1:8794)
# COT_JEV_HOST=          # bind address of `npm run jev:dev`
# COT_JEV_PORT=          # port of `npm run jev:dev`
# LAN helper (`npm run server:mp`; defaults in server/rooms/main.ts):
# COT_ROOMS_PORT=        # TCP port
# COT_ROOMS_HOST=        # bind address
# COT_ROOMS_ALLOWED_ORIGINS= # comma-separated exact origins; unset allows any (LAN)
# COT_ROOMS_MATCH_TRANSPORT= # service (match in the helper) or p2p (match in the host's browser)
# COT_MATCH_SEAT_SECRET= # HMAC secret for seat tokens; unset = generated per run (LAN only)
# COT_MATCH_CONTROL_SECRET= # bearer secret of the control routes; unset = the seat secret
# COT_MATCH_WORLD=       # dedicated (collision shards) or terrain
# COT_MATCH_LOG_LEVEL=   # debug, info, warn or error
