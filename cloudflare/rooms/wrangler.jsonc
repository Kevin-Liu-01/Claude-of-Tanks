{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cot-rooms",
  "account_id": "68c9576ef72404494de8d86348404fad",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "ratelimits": [{
    "name": "ROOM_CONNECT_LIMITER",
    "namespace_id": "2609055512",
    "simple": { "limit": 120, "period": 60 }
  }],
  "vars": {
    "ALLOWED_ORIGINS": "https://cot.kevinliu.studio",
    // Local development without a container runtime: the URL of a `node server/match/main.ts`
    // (or the LAN helper) the Worker calls instead of the MATCH binding. Empty in production.
    "MATCH_SHIM_URL": ""
  },
  // The match service image (server/match/Dockerfile, built from the repository root) on a
  // one-vCPU instance; one container per room code, started by the Room object at match start.
  "containers": [{
    "class_name": "MatchContainer",
    "image": "../../server/match/Dockerfile",
    "image_build_context": "../..",
    "instance_type": "standard-2",
    "max_instances": 20
  }],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "MATCH", "class_name": "MatchContainer" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "MatchContainer"] }]
}
