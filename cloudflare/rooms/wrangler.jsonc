{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cot-rooms",
  "account_id": "68c9576ef72404494de8d86348404fad",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "ratelimits": [{
    "name": "ROOM_CONNECT_LIMITER",
    "namespace_id": "2609055513",
    "simple": { "limit": 120, "period": 60 }
  }, {
    // the phone controller's pairing (docs/PHONE-CONTROLLER.md): its own window per client IP, apart from the rooms'
    "name": "PAD_CONNECT_LIMITER",
    "namespace_id": "2610300266",
    "simple": { "limit": 30, "period": 60 }
  }],
  // COT_STUN_URLS (2026-10-02, docs/MULTIPLAYER-V2.md §13.14): what a seat's `room_relay` grant carries when no TURN
  // credential can be minted (the relay secrets unset, the provider down) — pinned to OFFICIAL_STUN_URLS in
  // api/_lib/policy.ts by tools/deployment-policy.selftest.mjs. Relay secrets (names only, `wrangler secret put`):
  // COT_CLOUDFLARE_TURN_KEY_ID and COT_CLOUDFLARE_TURN_API_TOKEN; COT_TURN_TTL_SECONDS (a var) may shorten the hour.
  "vars": {
    "ALLOWED_ORIGINS": "https://cot.kevinliu.studio",
    "COT_STUN_URLS": "stun:stun.cloudflare.com:3478"
  },
  // Free plan (owner 2026-09-28): every match runs in the host commander's browser; this Worker carries rooms,
  // signaling and host migration only. The container backend left the tree with the cutover of 2026-09-29.
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      // the phone controller (2026-10-30, docs/PHONE-CONTROLLER.md): one object per pairing code, its own channel
      { "name": "PADS", "class_name": "PadPair" }
    ]
  },
  // v1 is the deployed history (Room and the container class of the first design); v2 deleted that class — a Worker
  // version may not stop exporting a class existing Durable Objects depend on, and the chain must create what it
  // deletes (2026-09-28). Never edit an applied tag; a class change is always a new tag.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "MatchContainer"] },
    { "tag": "v2", "deleted_classes": ["MatchContainer"] },
    { "tag": "v3", "new_sqlite_classes": ["PadPair"] }
  ],
  // The preview Worker (2026-10-30, Main's ruling for the phone controller's owner check): `wrangler deploy --env preview`
  // makes cot-rooms-preview, a separate Worker with its own Durable Object namespaces, limiter counters and migration chain,
  // admitting only the team's Vercel preview deployments (api/_lib/policy.ts ROOMS_PREVIEW_ALLOWED_ORIGINS, pinned by
  // tools/deployment-policy.selftest.mjs). A preview site build names it in VITE_ROOMS_URL (policy PREVIEW_ROOMS_URL).
  // Free plan: it shares the account's daily pools. Secrets are per Worker (`wrangler secret put <NAME> --env preview`):
  // pairing needs none; rooms answer room_unconfigured until MATCH_SEAT_SECRET is set there.
  "env": {
    "preview": {
      "name": "cot-rooms-preview",
      "workers_dev": true,
      "preview_urls": false,
      "observability": { "enabled": true, "head_sampling_rate": 0.1 },
      "ratelimits": [{
        "name": "ROOM_CONNECT_LIMITER",
        "namespace_id": "2610300267",
        "simple": { "limit": 120, "period": 60 }
      }, {
        "name": "PAD_CONNECT_LIMITER",
        "namespace_id": "2610300268",
        "simple": { "limit": 30, "period": 60 }
      }],
      "vars": {
        "ALLOWED_ORIGINS": "https://claude-of-tanks-*-kl01s-projects.vercel.app",
        "COT_STUN_URLS": "stun:stun.cloudflare.com:3478"
      },
      "durable_objects": {
        "bindings": [
          { "name": "ROOMS", "class_name": "Room" },
          { "name": "PADS", "class_name": "PadPair" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["Room", "PadPair"] }
      ]
    }
  }
}
