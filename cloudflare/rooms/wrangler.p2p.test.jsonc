// The Workers-runtime test configuration of the deployed shape (Free plan, peer-to-peer matches): the real
// Worker and Room object with no MATCH binding and no shim, so `createMatchHost` selects the p2p host and the
// Room object elects, relays signals for, and migrates the host commander's browser (test/p2p.test.ts).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cot-rooms-p2p-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "ratelimits": [{
    "name": "ROOM_CONNECT_LIMITER",
    "namespace_id": "2609055512",
    "simple": { "limit": 120, "period": 60 }
  }],
  "vars": {
    "ALLOWED_ORIGINS": "https://cot.kevinliu.studio",
    "MATCH_SHIM_URL": "",
    "MATCH_SEAT_SECRET": "rooms-test-seat-secret-0123456789abcdef"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
