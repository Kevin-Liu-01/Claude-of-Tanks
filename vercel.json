{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --no-audit",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": { "deploymentEnabled": false },
  "regions": ["sfo1"],
  "functions": {
    "api/*.ts": { "maxDuration": 10 }
  },
  "redirects": [
    { "source": "/:path(.*)", "has": [{ "type": "host", "value": { "eq": "claudeoftanks.kevinliu.studio" } }], "destination": "https://cot.kevinliu.studio/:path", "permanent": true },
    { "source": "/:path(.*)", "has": [{ "type": "host", "value": { "eq": "claude-of-tanks.vercel.app" } }], "destination": "https://cot.kevinliu.studio/:path", "permanent": true },
    { "source": "/surface-studio", "destination": "/gallery?layer=markup", "permanent": true },
    { "source": "/:lang(cn|es|ja|de|pt|ru)/surface-studio", "destination": "/:lang/gallery?layer=markup", "permanent": true },
    { "source": "/docs/vehicles{/}?", "destination": "/docs/tanks", "permanent": true },
    { "source": "/:lang(cn|es|ja|de|pt|ru)/docs/vehicles{/}?", "destination": "/:lang/docs/tanks", "permanent": true },
    { "source": "/docs/worlds{/}?", "destination": "/docs/battlefields", "permanent": true },
    { "source": "/:lang(cn|es|ja|de|pt|ru)/docs/worlds{/}?", "destination": "/:lang/docs/battlefields", "permanent": true },
    { "source": "/docs/interface{/}?", "destination": "/docs/controls", "permanent": true },
    { "source": "/:lang(cn|es|ja|de|pt|ru)/docs/interface{/}?", "destination": "/:lang/docs/controls", "permanent": true },
    { "source": "/docs/performance{/}?", "destination": "/docs/rendering", "permanent": true },
    { "source": "/:lang(cn|es|ja|de|pt|ru)/docs/performance{/}?", "destination": "/:lang/docs/rendering", "permanent": true },
    { "source": "/:page(home|docs|gallery|studio|brand)/", "destination": "/:page", "permanent": true },
    { "source": "/docs/:topic(build|models|simulation|rendering|ai|multiplayer|audio|studio|filming|modes|battlefields|combat|tanks|start|controls|fleet)/", "destination": "/docs/:topic", "permanent": true },
    { "source": "/:lang(cn|es|ja|de|pt|ru)/:page(home|docs|gallery|studio|brand)/", "destination": "/:lang/:page", "permanent": true },
    { "source": "/:lang(cn|es|ja|de|pt|ru)/docs/:topic(build|models|simulation|rendering|ai|multiplayer|audio|studio|filming|modes|battlefields|combat|tanks|start|controls|fleet)/", "destination": "/:lang/docs/:topic", "permanent": true }
  ],
  "headers": [
    {
      "source": "/:path(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "script-src 'self' 'wasm-unsafe-eval' https://www.googletagmanager.com 'sha256-/E2jY4uUOhsDB3sUCXfSOAUcHS+Iqt00AfENUwJnVK8=' 'sha256-6zfTrAqLkbi6tvQUwgS/FLSWSfC70U5KtA+PGnHRaak=' 'sha256-9hp0bsvVx2INaIyIWRuGIUbWZHRwkEhBWDxec8mH+XY=' 'sha256-MEQ5aQ5RPRYEJF5sCaZ0keCRBviUo4YfQfvGA0o1re0=' 'sha256-fInKe7RAsgeUneh2dwkUhPQZVCB23HlTdVpDBuJw0/E=' 'sha256-fobahHUzJRogwLusmO4xbhrWsUDIFOf12tKyK75sipM=' 'sha256-kmEsAlzgflC8xE27syBwl1XrDXNJUKPAgTHUndjMolc=' 'sha256-sHKacj8RQW6LgC7fdo5c0w1A/j8ZC1+WNg7QK7l1NCI=' 'sha256-ycAInyfvipaaR/Vv/OAYwo0ipoJ5Lk/wammuOx/SL8c='; worker-src 'self' blob:; object-src 'none'; base-uri 'self'" }
      ]
    },
    { "source": "/gallery", "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }] },
    { "source": "/gallery.html", "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }] },
    { "source": "/:lang(cn|es|ja|de|pt|ru)/gallery", "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }] },
    { "source": "/:lang(cn|es|ja|de|pt|ru)/gallery.html", "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }] }
  ],
  "rewrites": [
    { "source": "/:page(home|docs|gallery|brand|pad)", "destination": "/:page.html" },
    { "source": "/docs/:topic(build|models|simulation|rendering|ai|multiplayer|audio|studio|filming|modes|battlefields|combat|tanks|start|controls|fleet)", "destination": "/docs-:topic.html" },
    { "source": "/studio", "destination": "/index.html" },
    { "source": "/:lang(cn|es|ja|de|pt|ru)", "destination": "/:lang/index.html" },
    { "source": "/:lang(cn|es|ja|de|pt|ru)/:page(home|docs|gallery|studio|brand|404)", "destination": "/:lang/:page.html" },
    { "source": "/:lang(cn|es|ja|de|pt|ru)/docs/:topic(build|models|simulation|rendering|ai|multiplayer|audio|studio|filming|modes|battlefields|combat|tanks|start|controls|fleet)", "destination": "/:lang/docs-:topic.html" }
  ]
}
