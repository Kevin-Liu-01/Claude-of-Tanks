{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --no-audit",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": { "deploymentEnabled": false },
  "regions": ["sfo1"],
  "functions": {
    "api/*.ts": { "maxDuration": 10 }
  },
  "redirects": [
    { "source": "/:path(.*)", "has": [{ "type": "host", "value": { "eq": "claudeoftanks.kevinliu.studio" } }], "destination": "https://cot.kevinliu.studio/:path", "permanent": true },
    { "source": "/:path(.*)", "has": [{ "type": "host", "value": { "eq": "claude-of-tanks.vercel.app" } }], "destination": "https://cot.kevinliu.studio/:path", "permanent": true },
    { "source": "/surface-studio", "destination": "/gallery?layer=markup", "permanent": true },
    { "source": "/cn/surface-studio", "destination": "/cn/gallery?layer=markup", "permanent": true },
    { "source": "/:page(home|docs|gallery|studio)/", "destination": "/:page", "permanent": true },
    { "source": "/docs/:topic(build|models|simulation|vehicles|rendering|performance|worlds|ai|multiplayer|audio|interface|studio|filming)/", "destination": "/docs/:topic", "permanent": true },
    { "source": "/cn/:page(home|docs|gallery|studio)/", "destination": "/cn/:page", "permanent": true },
    { "source": "/cn/docs/:topic(build|models|simulation|vehicles|rendering|performance|worlds|ai|multiplayer|audio|interface|studio|filming)/", "destination": "/cn/docs/:topic", "permanent": true }
  ],
  "headers": [
    {
      "source": "/:path(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy-Report-Only", "value": "script-src 'self' https://www.googletagmanager.com 'sha256-6zfTrAqLkbi6tvQUwgS/FLSWSfC70U5KtA+PGnHRaak=' 'sha256-9hp0bsvVx2INaIyIWRuGIUbWZHRwkEhBWDxec8mH+XY=' 'sha256-CJeDO/rKyaeYSj76LZgY7I3dKspgoPY6bVAl5PqH5D0=' 'sha256-QgVJQ+AnzWYcTPPIURQsNz4SwHRgSkAL0qhut51ggHY=' 'sha256-T9tpAzxtJFbelvZ/7pBBG4jhkT9DOHdLz+ty/qq4vQU=' 'sha256-fInKe7RAsgeUneh2dwkUhPQZVCB23HlTdVpDBuJw0/E=' 'sha256-kmEsAlzgflC8xE27syBwl1XrDXNJUKPAgTHUndjMolc=' 'sha256-sAB19f6Yc4czmYchZcKL4U5/EvVHs5fw80NLXAD6DzQ=' 'sha256-ycAInyfvipaaR/Vv/OAYwo0ipoJ5Lk/wammuOx/SL8c='; worker-src 'self' blob:; object-src 'none'; base-uri 'self'" }
      ]
    },
    { "source": "/gallery", "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }] },
    { "source": "/gallery.html", "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }] },
    { "source": "/cn/gallery", "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }] },
    { "source": "/cn/gallery.html", "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }] }
  ],
  "rewrites": [
    { "source": "/:page(home|docs|gallery)", "destination": "/:page.html" },
    { "source": "/docs/:topic(build|models|simulation|vehicles|rendering|performance|worlds|ai|multiplayer|audio|interface|studio|filming)", "destination": "/docs-:topic.html" },
    { "source": "/studio", "destination": "/index.html" },
    { "source": "/cn", "destination": "/cn/index.html" },
    { "source": "/cn/:page(home|docs|gallery|studio|404)", "destination": "/cn/:page.html" },
    { "source": "/cn/docs/:topic(build|models|simulation|vehicles|rendering|performance|worlds|ai|multiplayer|audio|interface|studio|filming)", "destination": "/cn/docs-:topic.html" }
  ]
}
