{
  "name": "claude-of-tanks",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "agent-docs": "node scripts/run-agent-docs.ts",
    "fx:textures:bake": "node tools/bake-fx-textures.mjs",
    "minimap:assets": "node tools/bake-minimap-assets.mjs",
    "perf:terrain-stream": "node tools/terrain-stream-benchmark.mjs",
    "qa:maps": "node tools/map-environment-audit.mjs",
    "test:public-copy": "node src/presentation/publicCopy.selftest.mjs",
    "test:analytics": "node src/presentation/analytics.selftest.mjs",
    "test:stats": "node src/productStats.selftest.mjs",
    "test:seo": "node src/productStats.selftest.mjs && node src/presentation/seoMetadata.selftest.mjs",
    "test:public-nav": "node src/presentation/publicNav.selftest.mjs",
    "test:docs-reels": "node src/docs/battleReels.selftest.mjs",
    "attribution:check": "node tools/attribution-audit.mjs",
    "server:match": "node server/dedicatedMatchServer.ts",
    "pretest": "node tools/run-selftests.mjs pre",
    "test": "node tools/run-selftests.mjs core",
    "posttest": "node tools/run-selftests.mjs post",
    "server:signal": "node server/signalingServer.ts",
    "build": "VITE_PUBLIC_BUILD=1 vite build && node tools/strip-nc-assets.mjs",
    "build:private": "vite build",
    "build:public": "VITE_PUBLIC_BUILD=1 vite build && node tools/strip-nc-assets.mjs",
    "model:audit": "node tools/model-quality-audit.mjs --check",
    "model:rig": "node tools/model-rig-probe.mjs",
    "model:fidelity": "node tools/procedural-fidelity.mjs",
    "icons": "node tools/genIcons.mjs",
    "tank:assets": "node tools/genIcons.mjs",
    "tank:assets:check": "node tools/tank-assets-check.mjs",
    "tank:centering:update": "node tools/presentation-centering.mjs --update",
    "tank:centering:check": "node tools/presentation-centering.mjs --check",
    "tank:floor:check": "node src/vehicles/fleetFloorClearance.selftest.mjs",
    "tank:anatomy:update": "node tools/gen-combat-anatomy.mjs && node tools/gen-vehicle-marking-seats.mjs && node tools/genIcons.mjs --views hitZonesSide,armorSide,modulesSide",
    "tank:anatomy:check": "node tools/gen-combat-anatomy.mjs --check && node tools/gen-vehicle-marking-seats.mjs --check && node src/vehicles/combatAnatomy.selftest.mjs && node tools/tank-assets-check.mjs --views hitZonesSide,armorSide,modulesSide --skip-bore",
    "tank:marking-seats:update": "node tools/gen-vehicle-marking-seats.mjs",
    "tank:marking-seats:check": "node tools/gen-vehicle-marking-seats.mjs --check",
    "tank:appearance:check": "node tools/tank-assets-check.mjs --live-only --skip-bore",
    "tank:markings:check": "node tools/vehicle-marking-visibility.mjs",
    "tank:release:check": "node tools/tank-release-check.mjs",
    "tank:native:check": "node tools/native-playables-audit.mjs",
    "tank:family:check": "node src/vehicles/fleetOrder.selftest.mjs",
    "tank:roster": "node tools/vehicle-roster-report.mjs",
    "tank:roster:check": "node tools/vehicle-roster-report.mjs --check",
    "tank:track:duplicates": "node tools/track-duplicate-audit.mjs",
    "tank:surface-overlap:check": "node tools/coplanar-surface-overlap.selftest.mjs && node tools/fleet-surface-overlap-audit.mjs --check",
    "tank:track:check": "node tools/track-system-audit.mjs",
    "tank:track:round": "node tools/track-system-audit.mjs --round",
    "tank:track:maps": "node tools/track-system-audit.mjs --battle --maps=badlands,verdant,steppe,railyard",
    "tank:track:turning": "node tools/track-system-audit.mjs --turning --maps=badlands,verdant,steppe,railyard",
    "tank:freeze": "node tools/fleet-freeze-snapshot.mjs",
    "tank:freeze:check": "node tools/fleet-freeze-snapshot.mjs --check",
    "tank:bore:probe": "node tools/muzzle-bore-probe.mjs",
    "tank:gallery": "vite --host 127.0.0.1 --open /gallery?layer=markup",
    "shots": "node tools/screenshot.mjs",
    "shots:battle:generate": "node tools/marketing-shots/gen-battle-campaign.mjs",
    "shots:battle:grade": "node tools/marketing-shots/grade-battle-campaign.mjs",
    "studio:examples": "node tools/studio-example-videos.mjs",
    "studio:features:render": "node tools/studio-example-videos.mjs --collection features --count 6 --fps 30 --bitrate 7000000 --out shots/feature-loops-r1/masters",
    "studio:features:publish": "node tools/marketing-shots/publish-feature-loops.mjs",
    "studio:action:render": "node tools/marketing-shots/record-studio-action-loop.mjs",
    "landing:media:publish": "node tools/marketing-shots/publish-landing-media.mjs",
    "showcase:publish": "node tools/marketing-shots/publish-showcase-library.mjs && node tools/marketing-shots/build-capture-recipes.mjs",
    "showcase:recipes": "node tools/marketing-shots/build-capture-recipes.mjs",
    "showcase:check": "node tools/marketing-shots/showcase-library.selftest.mjs",
    "perf:dev": "node tools/dev-perf-probe.mjs",
    "perf:public": "node tools/public-page-perf-probe.mjs",
    "perf:cold": "node tools/cold-load-probe.mjs",
    "perf:resources": "node tools/phase-resource-probe.mjs --production",
    "perf:resources:gate": "node tools/phase-resource-probe.mjs --production --gate",
    "world:props:pack": "node tools/pack-prop-models.mjs",
    "qa:trace": "npm run build && node tools/qa-trace-probe.mjs",
    "qa:device": "npm run build && node tools/mobilelap.mjs --production --profile=native --soak-cycles=4 --soak-seconds=10 --out=.qa-device/native-scorecard.json --trace-out=.qa-device/native-trace.json --shots=.qa-device/native-shots",
    "qa:device:stress": "npm run build && node tools/mobilelap.mjs --production --profile=constrained --soak-cycles=4 --soak-seconds=10 --out=.qa-device/constrained-scorecard.json --trace-out=.qa-device/constrained-trace.json --shots=.qa-device/constrained-shots",
    "qa:device:software": "npm run build && node tools/mobilelap.mjs --production --profile=software --soak-cycles=4 --soak-seconds=10 --out=.qa-device/software-scorecard.json --trace-out=.qa-device/software-trace.json --shots=.qa-device/software-shots",
    "perf:loading": "node tools/loading-budget-probe.mjs",
    "perf:transitions": "node tools/loading-budget-probe.mjs --mode transitions",
    "test:net:browser": "node tools/multiplayer-browser-soak.mjs",
    "test:net:four": "node tools/multiplayer-four-player-soak.mjs",
    "test:net:seven": "node tools/multiplayer-four-player-soak.mjs --players=14 --team-size=7",
    "test:net:seven:live": "node tools/multiplayer-live-combat.mjs",
    "test:net:seven:full": "node tools/multiplayer-live-combat.mjs --complete-match --match-timeout=90000",
    "test:net:entry": "node tools/multiplayer-guest-entry.mjs",
    "net:prod:check": "node tools/production-multiplayer-check.mjs",
    "test:net:render": "node tools/multiplayer-render-perf.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [],
  "author": "Kevin B. Liu",
  "license": "SEE LICENSE IN LICENSE-POLICY.md",
  "type": "module",
  "dependencies": {
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.5",
    "flag-icons": "^7.5.0",
    "ioredis": "^6.0.0",
    "three": "^0.185.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.12",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "puppeteer": "^25.4.0",
    "typescript": "7.0.2",
    "vite": "^8.1.5"
  }
}
